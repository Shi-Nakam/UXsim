  "scenario": "fcfs_6x6_grid_3000_vehicle_all_links_200m_speed_60kph_departure_999_tmax_5000_completion_check_seed_0_demand_seed_42",
  "trial_purpose": "FCFS completion check under research candidate road conditions (all 168 links 200 m, 60 km/h free flow, jam density 0.2 veh/m) with 3000 vehicles evenly spaced over departure T=0..999 (nominal 3 veh/timestep). One exec_simulation observes T=0..4999. Checks whether all vehicles complete normally by T=4999, records completion timing and T=4999 link occupancy. Prior information for future 3000-vehicle TVT-MP trial design (evaluation end, TSIZE, observation horizon). Not a TVT-MP benchmark comparison.",
  "fcfs_completion_check_trial": true,
  "formal_performance_comparison": false,
  "future_3000_vehicle_tvt_mp_design_input": true,
  "completion_check_note": "This trial checks whether all vehicles complete normally by T=4999, records non-completion if any vehicles remain, and does not require successful full completion in order to write diagnostic outputs.",
  "t999_snapshot_reference_note": "Departure-end traffic snapshot at T=999 is stored by the existing departure-999 evaluation pretrial. This completion check does not re-fetch T=999 link or vehicle snapshots, does not split exec_simulation, and does not read pretrial output files at runtime.",
  "exec_simulation_once_note": "world.exec_simulation() is called exactly once. UXsim runs T=0..4999 even if all vehicles finish earlier; World.T after simulation is 5000.",
  "nominal_injection_rate_note": "Departure times are evenly spaced from T=0 through T=999 for 3000 vehicles. Nominal average injection rate over the 1000-timestep window (T=0..999) is 3.0 veh/timestep (3000 / 1000). If the same total rate were split evenly across the 24 external OD nodes, the nominal average would be 0.125 veh/timestep per node. Actual OD assignment follows random OD sampling and is not guaranteed to be uniform per external OD node.",
  "departure_comparison_note": "Same demand and road conditions as the departure T=999 FCFS pretrial (3000 vehicles, departure T=0..999, all links 200 m, 60 km/h). That pretrial stops at T=999; this completion check runs to T=4999.",
  "nominal_average_injection_rate_veh_per_timestep": 3.0,
  "nominal_average_injection_rate_veh_per_timestep_per_od_node": 0.125,
  "vehicle_plan_demand_match_note": "Vehicle plan generation uses the same NUM_VEHICLES, OD rules, departure spacing formula, and DEMAND_GEN_SEED as the departure-999 evaluation pretrial. vehicle_plan_sha256 should match that pretrial after execution; this script does not assert digest equality before run.",
  "road_condition_note": "All 168 directed links are 200 m. Free-flow speed is 60 km/h (~16.667 m/s). Jam density is 0.2 veh/m. capacity_in and capacity_out are not passed to addLink; UXsim default automatic values apply. No additional 1500 veh/h (0.4167 veh/s) boundary capacity is configured.",
  "road_condition_comparison_note": "Same research candidate road conditions as the departure T=999 FCFS pretrial (400 m / 300 m links, 20 m/s in the earlier non-200 m pretrial). This script extends simulation horizon to T=4999 for completion checking only.",
